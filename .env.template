# Metadata Agent API Configuration
# ================================

# LLM Provider Selection
# Options: 'openai', 'b-api-openai', 'b-api-academiccloud'
METADATA_AGENT_LLM_PROVIDER=b-api-academiccloud

# =========================================
# OpenAI Configuration (native OpenAI API)
# =========================================
OPENAI_API_KEY=sk-proj-your-api-key-here

# Muss nicht OpenAI sein: jeder Endpunkt, der /chat/completions bedient und
# einen Bearer-Token annimmt (Azure, vLLM, eigenes Gateway), funktioniert.
METADATA_AGENT_OPENAI_API_BASE=https://api.openai.com/v1
METADATA_AGENT_OPENAI_MODEL=gpt-4o-mini

# Leer lassen = METADATA_AGENT_LLM_TEMPERATURE gilt auch hier.
METADATA_AGENT_OPENAI_TEMPERATURE=

# =========================================
# B-API Configuration (OpenEduHub)
# =========================================
# Shared API key for both B-API providers
B_API_KEY=your-b-api-key-here

# B-API Base URL (Staging/Prod — Endpoint-Pfade werden automatisch abgeleitet)
# Staging: https://b-api.staging.openeduhub.net
# Prod:    https://b-api.prod.openeduhub.net
METADATA_AGENT_B_API_BASE_URL=https://b-api.staging.openeduhub.net

# B-API OpenAI (OpenAI-compatible endpoint via B-API)
# Wird automatisch aus B_API_BASE_URL abgeleitet, kann überschrieben werden:
# METADATA_AGENT_B_API_OPENAI_BASE=https://b-api.staging.openeduhub.net/api/v1/llm/openai
METADATA_AGENT_B_API_OPENAI_MODEL=gpt-5.6-luna

# Nur für die GPT-5-Serie und o-Modelle — gpt-4.1-mini & Co. lehnen beide mit
# 400 ab und bekommen sie deshalb gar nicht erst gesendet.
# reasoning_effort: none | low | medium | high  ('minimal' wird abgelehnt)
# 'none' ist ~40% schneller, verlor im Test aber Veranstaltungsdaten.
METADATA_AGENT_LLM_VERBOSITY=low
METADATA_AGENT_LLM_REASONING_EFFORT=low

# B-API AcademicCloud (AcademicCloud endpoint via B-API)
# 'deepseek-r1' antwortete mit 404 Model Not Found und ist deshalb nicht mehr
# der Default. Gemessen am 12.08.2026 lieferte 'deepseek-v4-flash' die
# gleichmaessigste Latenz der AcademicCloud-Modelle.
# METADATA_AGENT_B_API_ACADEMICCLOUD_BASE=https://b-api.staging.openeduhub.net/api/v1/llm/academiccloud
METADATA_AGENT_B_API_ACADEMICCLOUD_MODEL=deepseek-v4-flash

# =========================================
# General LLM Settings
# =========================================
METADATA_AGENT_LLM_TEMPERATURE=0.3
METADATA_AGENT_LLM_MAX_TOKENS=2000
METADATA_AGENT_LLM_MAX_RETRIES=3
METADATA_AGENT_LLM_RETRY_DELAY=1.0

# =========================================
# Durchsatzgrenzen des LLM-Gateways
# =========================================
# Gelten prozessweit, nicht pro Request. Leer = gemessener Default des
# Providers: b-api 2 gleichzeitig / 2 pro Sekunde (beide B-API-Provider teilen
# sich das Budget, weil die B-API am Key zaehlt und nicht am Modell),
# nativ OpenAI 10 gleichzeitig ohne Ratenbegrenzung.
#
# Die B-API weist einen dritten parallelen Request sofort mit 429 ab, und zwar
# ohne retry-after — die Grenze muss der Client einhalten, er kann sie nicht
# ablesen. Mehr Last hilft nicht: bei 3 req/s faellt der effektive Durchsatz
# unter den Wert bei 2 req/s.
#
# 0 bei REQUESTS_PER_SECOND schaltet die Ratenbegrenzung ab.
METADATA_AGENT_LLM_MAX_CONCURRENT_REQUESTS=
METADATA_AGENT_LLM_MAX_REQUESTS_PER_SECOND=

# =========================================
# Worker Settings
# =========================================
# Breite des parallelen Feld-Fan-outs. Wird auf
# METADATA_AGENT_LLM_MAX_CONCURRENT_REQUESTS gedeckelt — bei der B-API laufen
# also 2 Worker, egal was hier steht.
METADATA_AGENT_DEFAULT_MAX_WORKERS=10
METADATA_AGENT_REQUEST_TIMEOUT=60

# =========================================
# Default Schema Settings
# =========================================
METADATA_AGENT_DEFAULT_CONTEXT=default
# Use "latest" for automatic version detection, or specify like "1.8.0"
METADATA_AGENT_DEFAULT_VERSION=latest

# =========================================
# Normalization Settings
# =========================================
METADATA_AGENT_NORMALIZATION_ENABLED=true
METADATA_AGENT_NORMALIZATION_TEMPERATURE=0.1

# =========================================
# App Settings
# =========================================
METADATA_AGENT_DEBUG=false

# =========================================
# Input Source Settings
# =========================================
# Repository URL (for NodeID input source and upload)
# Staging: https://repository.staging.openeduhub.net/edu-sharing/rest
# Prod:    https://redaktion.openeduhub.net/edu-sharing/rest
METADATA_AGENT_REPOSITORY_URL=https://repository.staging.openeduhub.net/edu-sharing/rest

# Text Extraction API for URL input source
# Staging: https://text-extraction.staging.openeduhub.net
# Prod:    https://text-extraction.prod.openeduhub.net
METADATA_AGENT_TEXT_EXTRACTION_API_URL=https://text-extraction.staging.openeduhub.net
# Default extraction method: 'simple' or 'browser'
METADATA_AGENT_TEXT_EXTRACTION_DEFAULT_METHOD=simple

# WLO Repository Inbox ID (where new upload nodes are created)
METADATA_AGENT_WLO_INBOX_ID=21144164-30c0-4c01-ae16-264452197063

# =========================================
# Repository Upload (WLO edu-sharing)
# =========================================
# Required for /upload endpoint
# Get credentials from WLO admin
WLO_GUEST_USERNAME=
WLO_GUEST_PASSWORD=
